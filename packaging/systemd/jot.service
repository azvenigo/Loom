# jot - standalone jot ingest endpoint (plus one shared encrypted clip). See jot/main.cpp for what it
# does and why.
#
# Reachable off-LAN only by reverse proxy from an existing TLS vhost - see
# packaging/apache/jot-proxy.conf.example, which also lists what has to change HERE first (a
# token, and a firewall rule narrowing 7701 to the proxy host). Do not port-forward 7701 instead:
# jot answers every rejection with an indistinguishable bare 404, but that hides what is
# listening, not that something is - a scanner reads the TCP handshake and reports the port open
# regardless - and jot speaks plain HTTP, so a forwarded port puts the token on the wire.
#
# Kept deliberately minimal (no separate conf file, no dedicated user) to match how loom.service
# itself actually runs on azzorin today - straight out of the dev build tree as the owning user, not
# the packaged /usr/local/bin + dedicated-service-account story in packaging/install.sh. Revisit if
# this ever needs the same install/update/rollback treatment loom got.

[Unit]
Description=jot - jot ingest endpoint and shared encrypted clip
Documentation=https://github.com/azvenigo/Loom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alex
Group=alex
# LAN-only as it stands: no token, so anything that can route to 192.168.1.112 can write a jot.
# Before the Apache proxy above is switched on, append --token-file=/etc/loom/jot.token (a
# file, not --token=SECRET, which would be public in this repo and visible in `ps`).
ExecStart=/home/alex/dev/git/Loom/build/jot --bind=192.168.1.112 --port=7701 --path=/mnt/fast/web/jot_log/jots.json
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal

# Sandbox. jot is reachable from the internet (through the Apache proxy), so assume a bug in it or in
# the vendored HTTP library could one day be exploited, and make that worth as little as possible:
# it runs as the owning user, which on this box can reach the dev tree, ssh keys and the whole
# [fast] share. Everything below is tested to leave jot working (jots, clip PUT/GET/DELETE) - see
# the hardening test described in the zhotkey-encrypted-clipboard-sync jot.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
# The binary lives under /home (the dev build tree), so /home is replaced by an empty tmpfs with only
# the binary bound back in read-only: ssh keys and source are not even visible to the process.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/alex/dev/git/Loom/build/jot
# Read-only filesystem except the two places jot writes. The directories must exist before the
# service starts (a missing ReadWritePaths target fails the unit); jot creates the files inside.
ProtectSystem=strict
ReadWritePaths=/mnt/fast/web/jot_log /mnt/fast/web/jot_clip
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
